{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travis-true/enablement-systems-register/systems/sys-001-lace/schemas/asset-build-specification.schema.json",
  "title": "LACE Asset Build Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "template_version",
    "record_id",
    "system_id",
    "status",
    "owner",
    "created_date",
    "updated_date",
    "asset_id",
    "title",
    "family",
    "asset_type",
    "purpose",
    "performance_outcome",
    "audience",
    "use_context",
    "moment_of_need",
    "source_refs",
    "in_scope",
    "out_of_scope",
    "content_requirements",
    "accessibility_requirements",
    "technical_requirements",
    "deliverables",
    "acceptance_criteria",
    "readiness_status",
    "reviewers",
    "approver",
    "maintenance_trigger",
    "constraints",
    "assumptions",
    "unresolved_items"
  ],
  "properties": {
    "template_id": {
      "const": "LACE-TMP-005"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "const": "SYS-001"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "enum": [
        "performance-support-and-documentation",
        "instructor-led-and-virtual",
        "self-paced-digital",
        "video-and-multimedia",
        "communications-and-adoption",
        "planning-and-evaluation"
      ]
    },
    "asset_type": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "performance_outcome": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "use_context": {
      "type": "string",
      "minLength": 1
    },
    "moment_of_need": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "in_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "content_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "accessibility_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "technical_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "maintenance_trigger": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "readiness_status": {
      "enum": [
        "build-ready",
        "build-ready-with-documented-constraints",
        "not-build-ready"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness_status": {
            "const": "build-ready"
          }
        },
        "required": [
          "readiness_status"
        ]
      },
      "then": {
        "properties": {
          "unresolved_items": {
            "maxItems": 0
          },
          "constraints": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness_status": {
            "const": "build-ready-with-documented-constraints"
          }
        },
        "required": [
          "readiness_status"
        ]
      },
      "then": {
        "properties": {
          "constraints": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
