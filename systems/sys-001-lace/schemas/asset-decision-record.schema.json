{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travis-true/enablement-systems-register/systems/sys-001-lace/schemas/asset-decision-record.schema.json",
  "title": "LACE Asset Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "template_version",
    "record_id",
    "system_id",
    "status",
    "owner",
    "created_date",
    "updated_date",
    "request_id",
    "decision_engine_id",
    "decision_engine_version",
    "decision_status",
    "route",
    "matched_rules",
    "primary_asset",
    "companions",
    "rationale",
    "rejected_alternatives",
    "warnings",
    "required_human_reviews",
    "confidence",
    "decision_owner",
    "decision_date",
    "override"
  ],
  "properties": {
    "template_id": {
      "const": "LACE-TMP-009"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "const": "SYS-001"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_engine_id": {
      "const": "LACE-DE-001"
    },
    "decision_engine_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "decision_status": {
      "enum": [
        "blocked",
        "recommendation-ready",
        "approved",
        "overridden"
      ]
    },
    "route": {
      "enum": [
        "operational-fix",
        "assessment-or-evaluation",
        "communication-or-reference",
        "performance-support",
        "training-or-blended",
        "training",
        "further-analysis"
      ]
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(BLK|RTE|AST|CMP|WRN)-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "primary_asset": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "family",
        "asset_type",
        "template_id"
      ],
      "properties": {
        "family": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "performance-support-and-documentation",
            "instructor-led-and-virtual",
            "self-paced-digital",
            "video-and-multimedia",
            "communications-and-adoption",
            "planning-and-evaluation",
            null
          ]
        },
        "asset_type": {
          "type": "string",
          "minLength": 1
        },
        "template_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^LACE-TMP-[0-9]{3}$"
        }
      }
    },
    "companions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "family",
          "asset_type",
          "template_id"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "prepare",
              "deliver",
              "practice",
              "assess",
              "reinforce",
              "administer",
              "produce"
            ]
          },
          "family": {
            "enum": [
              "performance-support-and-documentation",
              "instructor-led-and-virtual",
              "self-paced-digital",
              "video-and-multimedia",
              "communications-and-adoption",
              "planning-and-evaluation"
            ]
          },
          "asset_type": {
            "type": "string",
            "minLength": 1
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^LACE-TMP-[0-9]{3}$"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_human_reviews": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "decision_owner": {
      "type": "string",
      "minLength": 1
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "override": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "requested_by",
        "reason",
        "tradeoffs",
        "approved_by",
        "approval_date"
      ],
      "properties": {
        "requested_by": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approval_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_status": {
            "enum": [
              "recommendation-ready",
              "approved",
              "overridden"
            ]
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "matched_rules": {
            "minItems": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "blocked"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "required_human_reviews": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": {
            "const": "overridden"
          }
        },
        "required": [
          "decision_status"
        ]
      },
      "then": {
        "properties": {
          "override": {
            "type": "object"
          }
        }
      }
    }
  ]
}
