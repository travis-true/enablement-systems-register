{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travis-true/enablement-systems-register/systems/sys-001-lace/schemas/request-intake-record.schema.json",
  "title": "LACE Request and Intake Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "template_version",
    "record_id",
    "system_id",
    "status",
    "owner",
    "created_date",
    "updated_date",
    "request_id",
    "title",
    "requester",
    "request_date",
    "business_need",
    "performance_outcome",
    "audience",
    "use_context",
    "task_or_workflow",
    "risk_level",
    "delivery_constraints",
    "source_refs",
    "requested_due_date",
    "assumptions",
    "known_gaps"
  ],
  "properties": {
    "template_id": {
      "const": "LACE-TMP-003"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "const": "SYS-001"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "request_date": {
      "type": "string",
      "format": "date"
    },
    "business_need": {
      "type": "string",
      "minLength": 1
    },
    "performance_outcome": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "use_context": {
      "type": "string",
      "minLength": 1
    },
    "task_or_workflow": {
      "type": "string",
      "minLength": 1
    },
    "risk_level": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "delivery_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requested_due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
