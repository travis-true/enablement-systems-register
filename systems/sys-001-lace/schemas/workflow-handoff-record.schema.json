{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/travis-true/enablement-systems-register/systems/sys-001-lace/schemas/workflow-handoff-record.schema.json",
  "title": "LACE Workflow and Handoff Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "template_version",
    "record_id",
    "system_id",
    "status",
    "owner",
    "created_date",
    "updated_date",
    "asset_id",
    "from_stage",
    "to_stage",
    "handoff_status",
    "deliverables",
    "open_items",
    "documented_constraints",
    "transferring_owner",
    "receiving_owner",
    "acknowledgment",
    "handoff_date"
  ],
  "properties": {
    "template_id": {
      "const": "LACE-TMP-006"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "const": "SYS-001"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "superseded"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "updated_date": {
      "type": "string",
      "format": "date"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "from_stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "to_stage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "handoff_status": {
      "enum": [
        "pending",
        "accepted",
        "returned",
        "accepted-with-constraints"
      ]
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "documented_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "transferring_owner": {
      "type": "string",
      "minLength": 1
    },
    "receiving_owner": {
      "type": "string",
      "minLength": 1
    },
    "acknowledgment": {
      "type": "string",
      "minLength": 1
    },
    "handoff_date": {
      "type": "string",
      "format": "date"
    }
  }
}
