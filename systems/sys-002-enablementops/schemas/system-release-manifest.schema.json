{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["record_id", "system_id", "release_version", "status", "authority", "authorization_date", "basis", "validation", "defects", "scope", "exclusions", "review", "rollback"],
  "additionalProperties": false,
  "properties": {
    "record_id": {"type": "string", "pattern": "^EO-REL-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "system_id": {"const": "SYS-002"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "released"},
    "authority": {"type": "string", "minLength": 1},
    "authorization_date": {"type": "string", "format": "date"},
    "basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "validation": {
      "type": "object",
      "required": ["schema", "semantic", "regression_tests", "human_authorization"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "pass"},
        "semantic": {"const": "pass"},
        "regression_tests": {"type": "integer", "minimum": 1},
        "human_authorization": {"const": true}
      }
    },
    "defects": {
      "type": "object",
      "required": ["blocker", "critical", "major"],
      "additionalProperties": false,
      "properties": {
        "blocker": {"const": 0},
        "critical": {"const": 0},
        "major": {"const": 0}
      }
    },
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review": {
      "type": "object",
      "required": ["owner", "next_review"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "next_review": {"type": "string", "format": "date"}
      }
    },
    "rollback": {"type": "string", "minLength": 10}
  }
}
