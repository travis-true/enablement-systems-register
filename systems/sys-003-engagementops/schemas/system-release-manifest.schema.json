{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["record_id","system_id","release_version","status","authority","authorization_date","basis","validation","defects","scope","exclusions","review","rollback"],"additionalProperties":false,"properties":{"record_id":{"type":"string","pattern":"^EO-SYS-REL-[0-9]+\\.[0-9]+\\.[0-9]+$"},"system_id":{"const":"SYS-003"},"release_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"status":{"const":"released"},"authority":{"type":"string","minLength":1},"authorization_date":{"type":"string","format":"date"},"basis":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"validation":{"type":"object","required":["schemas","core_regression_tests","pilot_regression_tests","pilot","semantic","human_authorization"],"additionalProperties":false,"properties":{"schemas":{"type":"integer","minimum":1},"core_regression_tests":{"type":"integer","minimum":1},"pilot_regression_tests":{"type":"integer","minimum":1},"pilot":{"const":"pass"},"semantic":{"const":"pass"},"human_authorization":{"const":true}}},"defects":{"type":"object","required":["blocker","critical","major","minor"],"additionalProperties":false,"properties":{"blocker":{"const":0},"critical":{"const":0},"major":{"const":0},"minor":{"const":0}}},"scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"exclusions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"review":{"type":"object","required":["owner","next_review"],"additionalProperties":false,"properties":{"owner":{"type":"string","minLength":1},"next_review":{"type":"string","format":"date"}}},"rollback":{"type":"string","minLength":10}}}
